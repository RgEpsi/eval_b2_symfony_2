{% extends 'base.html.twig' %}

{# Évaluation 2 – page « Mes inscriptions » : HTML statique à rendre dynamique #}

{% block title %}Mes inscriptions{% endblock %}

{% block body %}
    <div class="section-head">
        <div>
            <h1>Mes inscriptions</h1>
            <p class="muted">Vous êtes inscrit à {{ events | length }} événement(s).</p>
        </div>
    </div>
    {% set mois = ['janv.', 'févr.', 'mars', 'avr.', 'mai', 'juin', 'juil.', 'août', 'sept.', 'oct.', 'nov.', 'déc.'] %}
    {%if (events | length > 0)%}
        <ul class="event-list">
            {% for event in events %}
                {{ include('event/card.html.twig', {
                    event: event,
                    mois: mois,
                    showUnregister: true
                }) 
            }}
        </ul>
    {% endfor %}
    </ul>

    {% else %}
        <p class="empty">
            Vous n'êtes inscrit à aucun événement pour le moment.
        </p>
    {% endif %}

    {# Si l'utilisateur n'est inscrit à aucun événement :
    <p class="empty">Vous n'êtes inscrit à aucun événement pour le moment.</p>
    #}
{% endblock %}
